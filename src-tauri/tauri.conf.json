{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "错题智库",
  "version": "0.3.5",
  "identifier": "com.cuoti.zhiku",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "错题智库", "width": 1320, "height": 840, "minWidth": 760, "minHeight": 520 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "resources/windows-x64/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
